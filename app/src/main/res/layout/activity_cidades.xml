<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerenciamento de Cidades"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/edNomeCidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome da Cidade"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edDddCidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="DDD"
        android:inputType="number"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSalvarCidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salvar"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtro de cidade:"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="4dp"/>

    <Spinner
        android:id="@+id/spinnerCidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"/>

    <ListView
        android:id="@+id/lista_cidades"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>